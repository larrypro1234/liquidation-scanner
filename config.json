  "rules": {
    "captchaSelector": "form[action*=\"validateCaptcha\"]",
    "captchaTitle": "robot check",
    "captchaText": "not a robot|enter the characters you see",
    "cardSelector": "[data-asin]",
    "cardAsinAttr": "data-asin",
    "linkSelector": "a[href*=\"/dp/\"], a[href*=\"/gp/product/\"]",
    "linkAsinPattern": "/(?:dp|gp/product)/([A-Z0-9]{10})",
    "titleSelector": "h2, [data-cy=\"title-recipe\"]",
    "priceSelectors": [
      ".a-price:not(.a-text-price) .a-offscreen",
      ".a-price .a-offscreen",
      "[class*=\"price\"]"
    ],
    "listPriceSelector": ".a-price.a-text-price .a-offscreen, [data-a-strike=\"true\"] .a-offscreen",
    "retailPatterns": [
      "(?:retail|msrp|value|worth)\\D{0,25}\\$\\s*(\\d+(?:\\.\\d+)?)\\s*(k\\b)?",
      "\\$\\s*(\\d+(?:\\.\\d+)?)\\s*(k\\b)?\\s*(?:est\\.?\\s*|estimated\\s*|total\\s*)?(?:retail|msrp|value)"
    ],
    "unitsPattern": "(\\d{1,6})\\s*\\+?\\s*(?:units|items|pcs|pieces|products)\\b",
    "unavailablePattern": "currently unavailable|out of stock",
    "sponsoredSelector": ".puis-sponsored-label-text",
    "maxItemsPerPage": 200,
    "lotTypes": [
      {
        "label": "Customer Returns",
        "pattern": "customer return|\\breturn(?:s|ed)?\\b"
      },
      {
        "label": "Overstock",
        "pattern": "overstock|over-stock|excess inventory|surplus"
      },
      {
        "label": "Shelf Pulls",
        "pattern": "shelf[ -]?pulls?"
      },
      {
        "label": "Refurbished",
        "pattern": "refurb"
      },
      {
        "label": "Like New",
        "pattern": "like[ -]new|open[ -]box"
      },
      {
        "label": "Salvage",
        "pattern": "salvage|damaged|as[ -]is\\b|untested|for parts"
      },
      {
        "label": "Used",
        "pattern": "\\bused\\b|pre-?owned"
      },
      {
        "label": "Mixed",
        "pattern": "mixed condition|mixed"
      },
      {
        "label": "New",
        "pattern": "brand[ -]new|\\bnew\\b"
      }
    ],
    "titlePattern": "^\\s*(?<units>\\d[\\d,]*)\\s*units?\\s*\\(\\s*est\\.?\\s*(?<pallets>[\\d.]+)\\s*pallets?\\s*\\)\\s*-\\s*(?<type>.+?)\\s*-\\s*(?<category>.+?)(?:\\s+lot)?\\s*$",
    "manifest": {
      "topN": 5,
      "delayMs": 10000,
      "tableSelector": "table, [role=\"table\"], [role=\"grid\"]",
      "tableHeaderPattern": "qty|quantity",
      "seeAllPattern": "see all\\s*\\((\\d+)\\)",
      "columns": {
        "condition": "condition",
        "type": "product type|category",
        "brand": "brand",
        "asin": "asin",
        "title": "title|description",
        "qty": "^qty|quantity",
        "price": "item price|unit price|price per",
        "total": "total"
      }
    },
    "throttleTitle": "sorry! something went wrong",
    "throttleText": "something went wrong on our end|dogs of amazon"
  },
  "performance": {
    "blockTypes": [
      "image",
      "media",
      "font",
      "script",
      "sub_frame"
